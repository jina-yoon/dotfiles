#!/usr/bin/env python3
"""Notify me when a skill I edited in Cowork has drifted from dotfiles.

Cowork edits happen server-side and land in a local cache; nothing carries them
back to the repo. This watches that cache and tells me when the two disagree.
It never copies or commits anything — Cowork's skill editor has been known to
overwrite frontmatter, so pulling is a decision I make by hand.

  skill-watch               check once, notify if the drift is new
  skill-watch --install     write the launchd agent and start it
  skill-watch --uninstall   stop and remove the agent
  skill-watch --status      is the agent loaded, what is it watching

The launchd agent fires on two triggers: a WatchPaths kqueue on Cowork's
manifest.json (near-instant, but goes stale when Cowork rotates its session
UUIDs) and a half-hourly StartInterval that catches whatever the kqueue missed.
Every run re-discovers the manifest paths and rewrites the agent if they moved,
so the stale-UUID case heals itself within one interval.
"""

import hashlib
import plistlib
import re
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
LABEL = "com.jina.skill-watch"
PLIST = HOME / "Library" / "LaunchAgents" / f"{LABEL}.plist"
SELF = Path(__file__).resolve()
SKILL_STATUS = SELF.parent / "skill-status"
COWORK_ROOT = (
    HOME / "Library" / "Application Support" / "Claude"
    / "local-agent-mode-sessions" / "skills-plugin"
)
# Kept out of git via the *.local rule in .gitignore.
STATE = HOME / ".dotfiles" / "ai" / "skill-watch.state.local"
LOG = HOME / ".dotfiles" / "ai" / "skill-watch.log.local"

INTERVAL = 1800  # seconds; the fallback for when WatchPaths has gone stale


def log(msg):
    from datetime import datetime
    try:
        with LOG.open("a") as fh:
            fh.write(f"{datetime.now().isoformat(timespec='seconds')}  {msg}\n")
    except OSError:
        pass


def watch_paths():
    """Every Cowork manifest.json, newest account first.

    Watching all of them rather than just the active account means a Cowork
    session switch is itself a trigger, not something we wait an interval to
    notice.
    """
    found = []
    if not COWORK_ROOT.is_dir():
        return found
    for mf in sorted(COWORK_ROOT.glob("*/*/manifest.json")):
        try:
            found.append((mf.stat().st_mtime, str(mf)))
        except OSError:
            continue
    return [p for _, p in sorted(found, reverse=True)]


def build_plist(paths):
    return {
        "Label": LABEL,
        "ProgramArguments": [str(SELF)],
        "WatchPaths": paths,
        "StartInterval": INTERVAL,
        "ThrottleInterval": 10,
        "RunAtLoad": False,
        "StandardErrorPath": str(LOG),
    }


def installed_paths():
    try:
        with PLIST.open("rb") as fh:
            return plistlib.load(fh).get("WatchPaths", [])
    except (OSError, plistlib.InvalidFileException):
        return None


def write_plist(paths):
    PLIST.parent.mkdir(parents=True, exist_ok=True)
    with PLIST.open("wb") as fh:
        plistlib.dump(build_plist(paths), fh)


def bootout():
    subprocess.run(
        ["launchctl", "bootout", f"gui/{os_uid()}/{LABEL}"],
        capture_output=True,
    )


def bootstrap():
    return subprocess.run(
        ["launchctl", "bootstrap", f"gui/{os_uid()}", str(PLIST)],
        capture_output=True, text=True,
    )


def os_uid():
    import os
    return os.getuid()


def notify(title, body):
    # osascript is the only notification route that works from a launchd agent
    # without shipping an app bundle to own the notification.
    body = body.replace('"', "'")
    title = title.replace('"', "'")
    subprocess.run(
        ["osascript", "-e",
         f'display notification "{body}" with title "{title}"'],
        capture_output=True,
    )


def drifted_names(text):
    """Skill names from skill-status's DRIFT block.

    Findings are indented two spaces under DRIFT; their detail lines are
    indented further, so the indent width is what separates them.
    """
    names, in_drift = [], False
    for line in text.splitlines():
        if line.startswith("DRIFT"):
            in_drift = True
            continue
        if in_drift:
            m = re.match(r"^ {2}(\S+)", line)
            if m and m.group(1) not in names:
                names.append(m.group(1))
    return names


def sync_agent():
    """Rewrite and reload the agent if Cowork's manifest paths have moved."""
    paths = watch_paths()
    if not paths:
        return
    current = installed_paths()
    if current is None or sorted(current) != sorted(paths):
        write_plist(paths)
        bootout()
        bootstrap()
        log(f"watch paths refreshed ({len(paths)} manifest(s))")


def check():
    proc = subprocess.run(
        [str(SKILL_STATUS), "--drift-only", "--no-repos"],
        capture_output=True, text=True,
    )
    if proc.returncode >= 2:
        log(f"skill-status failed rc={proc.returncode}: {proc.stderr.strip()[:200]}")
        return proc.returncode
    if proc.returncode == 0:
        # Clean again — forget the last notice so the next drift speaks up.
        STATE.unlink(missing_ok=True)
        return 0

    out = proc.stdout
    digest = hashlib.sha256(out.encode()).hexdigest()
    try:
        if STATE.read_text().strip() == digest:
            return 1  # same drift as last time; already said so
    except OSError:
        pass

    names = drifted_names(out)
    body = ", ".join(names[:4]) or "see skill-status"
    if len(names) > 4:
        body += f" +{len(names) - 4} more"
    notify(
        f"{len(names)} skill{'s' if len(names) != 1 else ''} drifted from dotfiles",
        body,
    )
    log(f"notified: {body}")
    try:
        STATE.write_text(digest)
    except OSError:
        pass
    return 1


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""

    if arg == "--install":
        paths = watch_paths()
        if not paths:
            print(f"no Cowork manifest under {COWORK_ROOT}", file=sys.stderr)
            return 2
        write_plist(paths)
        bootout()
        res = bootstrap()
        if res.returncode != 0:
            print(f"launchctl bootstrap failed: {res.stderr.strip()}", file=sys.stderr)
            return 2
        print(f"installed {LABEL}")
        for p in paths:
            print(f"  watching {p}")
        print(f"  fallback check every {INTERVAL // 60} min")
        return 0

    if arg == "--uninstall":
        bootout()
        PLIST.unlink(missing_ok=True)
        STATE.unlink(missing_ok=True)
        print(f"removed {LABEL}")
        return 0

    if arg == "--status":
        # `launchctl list <label>` reports rc=1 for a loaded-but-idle agent on
        # this macOS; `print` against the gui domain is the honest check.
        res = subprocess.run(
            ["launchctl", "print", f"gui/{os_uid()}/{LABEL}"],
            capture_output=True, text=True,
        )
        if res.returncode != 0:
            print("not loaded")
        else:
            m = re.search(r"^\s*state = (.+)$", res.stdout, re.M)
            print(f"loaded ({m.group(1).strip()})" if m else "loaded")
        for p in installed_paths() or []:
            print(f"  watching {p}")
        live = watch_paths()
        if sorted(live) != sorted(installed_paths() or []):
            print("  (watch paths are stale — next run will refresh them)")
        return 0

    if arg:
        print(__doc__, file=sys.stderr)
        return 2

    sync_agent()
    return check()


if __name__ == "__main__":
    sys.exit(main())
