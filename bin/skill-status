#!/usr/bin/env python3
"""Inventory the Claude skills I author, and report where copies have drifted.

Read-only. Never writes to any surface — it tells you what's out of sync and
leaves the fixing to you.

Skills I write end up in several places at once: dotfiles is the source, Claude
Code symlinks it, Cowork keeps its own server-side copy that has to be uploaded
by hand, and some live only in a repo. Copies diverge silently. This reports
them side by side and exits non-zero when two disagree.

  skill-status                 full report
  skill-status --drift-only    just the problems
  skill-status --diff <name>   full diff of one skill against Cowork
  skill-status --json          machine-readable
  skill-status --no-repos      skip the repo scan

Exit: 0 clean, 1 drift found, 2 tool error.
"""

import argparse
import difflib
import json
import os
import re
import subprocess
import sys
import zipfile
from datetime import datetime
from pathlib import Path

HOME = Path.home()
DOTFILES = HOME / ".dotfiles" / "ai" / "skills"
CLAUDE_SKILLS = HOME / ".claude" / "skills"
SCHEDULED = HOME / "Documents" / "Claude" / "Scheduled"
BUNDLES = HOME / "Desktop" / "cowork-skills"
CONFIG = HOME / ".dotfiles" / "ai" / "skill-sources.json"
COWORK_ROOT = (
    HOME / "Library" / "Application Support" / "Claude"
    / "local-agent-mode-sessions" / "skills-plugin"
)

DIFF_PREVIEW_LINES = 14
# Cowork's server timestamp and a local mtime aren't the same clock.
CLOCK_SKEW = 120  # seconds


# ---------------------------------------------------------------- formatting

class Style:
    def __init__(self, enabled):
        self.on = enabled

    def _w(self, code, s):
        return f"\033[{code}m{s}\033[0m" if self.on else s

    def bold(self, s):
        return self._w("1", s)

    def dim(self, s):
        return self._w("2", s)

    def warn(self, s):
        return self._w("33", s)

    def err(self, s):
        return self._w("31", s)

    def ok(self, s):
        return self._w("32", s)


def visible_len(s):
    return len(re.sub(r"\033\[[0-9;]*m", "", s))


def pad(s, width):
    return s + " " * max(0, width - visible_len(s))


# ------------------------------------------------------------------ parsing

def read_text(path):
    """Read a file, returning None rather than raising on the usual failures."""
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except (OSError, PermissionError):
        return None


def parse_frontmatter(text):
    """Pull name, description and metadata.cowork out of YAML frontmatter.

    Hand-rolled because PyYAML isn't installed and these three fields are all
    we need. Handles the block scalars (`>-`, `>`, `|`) the descriptions use.
    """
    out = {"name": None, "description": None, "cowork": False}
    if not text or not text.startswith("---"):
        return out

    lines = text.split("\n")
    end = None
    for i, line in enumerate(lines[1:], start=1):
        if line.rstrip() == "---":
            end = i
            break
    if end is None:
        return out

    fm = lines[1:end]
    in_metadata = False
    key = None
    buf = []

    def flush():
        if key in ("name", "description") and buf:
            out[key] = " ".join(p.strip() for p in buf if p.strip())

    for line in fm:
        # A non-indented, non-comment line starts a new top-level key.
        if line and not line[0].isspace() and not line.lstrip().startswith("#"):
            flush()
            key, buf = None, []
            in_metadata = False
            m = re.match(r"^([A-Za-z0-9_-]+):\s*(.*)$", line)
            if not m:
                continue
            k, v = m.group(1), m.group(2).strip()
            if k == "metadata":
                in_metadata = True
            elif k in ("name", "description"):
                key = k
                # `>-`, `>`, `|` mean the value continues on following lines.
                buf = [] if v in (">", ">-", "|", "|-", "") else [v]
        elif in_metadata:
            if re.match(r"^\s+cowork:\s*true\s*$", line):
                out["cowork"] = True
        elif key:
            buf.append(line)

    flush()
    return out


def scalar_value(first, rest):
    """Decode one top-level YAML scalar to its string value.

    `first` is what follows `key:` on its own line, `rest` the indented
    continuation lines. Covers the forms that turn up in SKILL.md: plain,
    single- and double-quoted (each possibly wrapped), and block scalars.
    """
    m = re.match(r"^([>|])([+-]?)$", first)
    if m:
        style, chomp = m.groups()
        body = [ln.strip() for ln in rest]
        if style == "|":
            value = "\n".join(body)
        else:
            # Folding: a line break becomes a space, a blank line a newline.
            value, prev_blank = "", True
            for ln in body:
                if ln == "":
                    value += "\n"
                    prev_blank = True
                else:
                    value += ("" if prev_blank else " ") + ln
                    prev_blank = False
        value = value.rstrip("\n")
        return value if chomp == "-" else value + "\n"

    joined = " ".join([first] + [ln.strip() for ln in rest if ln.strip()])
    if len(joined) >= 2 and joined[0] == joined[-1] == "'":
        return joined[1:-1].replace("''", "'")
    if len(joined) >= 2 and joined[0] == joined[-1] == '"':
        try:
            return json.loads(joined)
        except ValueError:
            return joined[1:-1]
    return joined


def canonical_frontmatter(fm):
    """Rewrite frontmatter lines so equal values compare equal.

    Cowork re-serialises frontmatter on upload — a wrapped `>-` description
    comes back as one quoted line — so comparing raw text reports drift for
    a skill whose content never changed. Top-level scalars are decoded and
    re-emitted as `key: <json string>`; nested mappings like `metadata:` are
    kept line by line with their indentation evened out.
    """
    out, i = [], 0
    while i < len(fm):
        line = fm[i]
        m = re.match(r"^([A-Za-z0-9_-]+):\s*(.*)$", line)
        if not m or line[0].isspace():
            out.append(line.strip())
            i += 1
            continue
        key, first = m.group(1), m.group(2).strip()
        j = i + 1
        while j < len(fm) and (fm[j] == "" or fm[j][0].isspace()):
            j += 1
        rest = fm[i + 1:j]
        while rest and rest[-1] == "":
            rest.pop()
        nested = (first == "" and rest
                  and re.match(r"^\s+[A-Za-z0-9_-]+:(\s|$)", rest[0]))
        if nested:
            out.append(f"{key}:")
            out.extend("  " + ln.strip() for ln in rest if ln.strip())
        else:
            out.append(f"{key}: {json.dumps(scalar_value(first, rest), ensure_ascii=False)}")
        i = j
    return out


def normalize(text):
    """Canonical form for content comparison.

    Trailing whitespace and blank-line runs differ between an editor and a
    round-trip through Cowork's store without the skill actually changing,
    and so does how frontmatter values are quoted and wrapped. What the
    values say is significant: a changed description changes when the skill
    fires.
    """
    if text is None:
        return None
    lines = [ln.rstrip() for ln in text.replace("\r\n", "\n").split("\n")]
    if lines and lines[0] == "---" and "---" in lines[1:]:
        end = lines.index("---", 1)
        lines = ["---"] + canonical_frontmatter(lines[1:end]) + lines[end:]
    out, blank = [], False
    for ln in lines:
        if ln == "":
            if not blank:
                out.append("")
            blank = True
        else:
            out.append(ln)
            blank = False
    while out and out[-1] == "":
        out.pop()
    return "\n".join(out)


# ------------------------------------------------------------------ surfaces

def parse_iso(value):
    """Cowork's updatedAt -> epoch seconds. None for a freshly created skill."""
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except (ValueError, AttributeError):
        return None


def git_state(path):
    """'committed', 'uncommitted', or None if not in a repo.

    An exported skill sitting uncommitted in the working tree is still
    unbacked — the export writes files but doesn't commit them.
    """
    root = repo_root(Path(path).parent)
    if root is None:
        return None
    out = git(root, "status", "--porcelain", "--", str(path))
    if out is None:
        return None
    return "uncommitted" if out.strip() else "committed"


def load_skill_dir(path):
    """Read one <name>/SKILL.md directory into a record."""
    md = path / "SKILL.md"
    text = read_text(md)
    if text is None:
        return None
    fm = parse_frontmatter(text)
    mtime = 0.0
    for f in path.rglob("*"):
        try:
            if f.is_file():
                mtime = max(mtime, f.stat().st_mtime)
        except OSError:
            continue
    return {
        "name": path.name,
        "path": str(path),
        "mtime": mtime,
        "declared_name": fm["name"],
        "description": fm["description"],
        "cowork": fm["cowork"],
        "text": text,
        "norm": normalize(text),
        "lines": len(text.split("\n")),
    }


def scan_dir(root):
    """Every <name>/SKILL.md one level under root. Follows symlinks."""
    found = {}
    if not root.is_dir():
        return found
    try:
        entries = sorted(root.iterdir())
    except (OSError, PermissionError):
        return found
    for entry in entries:
        # resolve() so symlinked skills (dotfiles -> ~/.claude/skills) count.
        try:
            if not entry.resolve().is_dir():
                continue
        except OSError:  # dangling symlink
            continue
        rec = load_skill_dir(entry)
        if rec:
            rec["symlink"] = entry.is_symlink()
            found[entry.name] = rec
    return found


def find_cowork_root():
    """The Cowork account dir with the newest manifest.

    Two account UUIDs exist on this machine; hardcoding either would silently
    read a stale account, so pick by manifest lastUpdated.
    """
    best, best_ts = None, -1
    if not COWORK_ROOT.is_dir():
        return None, None
    try:
        outer_dirs = list(COWORK_ROOT.iterdir())
    except (OSError, PermissionError):
        return None, None
    for outer in outer_dirs:
        try:
            inner_dirs = list(outer.iterdir())
        except (OSError, PermissionError):
            continue
        for inner in inner_dirs:
            mf = inner / "manifest.json"
            raw = read_text(mf)
            if raw is None:
                continue
            try:
                data = json.loads(raw)
            except json.JSONDecodeError:
                continue
            ts = data.get("lastUpdated") or 0
            if ts > best_ts:
                best, best_ts = (inner, data), ts
    if best is None:
        return None, None
    return best[0], best[1]


def load_cowork(not_mine=frozenset()):
    """Cowork skills that are mine, merged with their on-disk SKILL.md.

    creatorType "user" only means some account uploaded it, not that I wrote
    it — skills imported from elsewhere carry the same tag. The not_mine list
    in skill-sources.json is the only way to tell those apart.
    """
    root, manifest = find_cowork_root()
    if root is None:
        return {"available": False, "skills": {}, "total": 0, "synced": None}

    entries = manifest.get("skills") or []
    on_disk = scan_dir(root / "skills")
    mine = {}
    for e in entries:
        if e.get("creatorType") != "user":
            continue
        name = e.get("name")
        if not name or name in not_mine:
            continue
        rec = on_disk.get(name, {})
        mine[name] = {
            "name": name,
            "skill_id": e.get("skillId"),
            "enabled": e.get("enabled", True),
            # Freshly created skills carry a null updatedAt.
            "updated_at": e.get("updatedAt"),
            "description": e.get("description"),
            "norm": rec.get("norm"),
            "text": rec.get("text"),
            "lines": rec.get("lines"),
            "path": rec.get("path"),
        }
    synced = manifest.get("lastUpdated")
    excluded = sorted(
        e["name"] for e in entries
        if e.get("creatorType") == "user" and e.get("name") in not_mine
    )
    return {
        "available": True,
        "skills": mine,
        "excluded": excluded,
        "total": len(entries),
        "synced": datetime.fromtimestamp(synced / 1000) if synced else None,
        "root": str(root),
    }


def load_bundles():
    """Staged .skill zips, with the mtime of the SKILL.md inside each."""
    out = {}
    if not BUNDLES.is_dir():
        return out
    for f in sorted(BUNDLES.glob("*.skill")):
        rec = {"name": f.stem, "path": str(f), "mtime": f.stat().st_mtime, "norm": None}
        try:
            with zipfile.ZipFile(f) as z:
                for member in z.namelist():
                    if member.endswith("/SKILL.md"):
                        rec["norm"] = normalize(z.read(member).decode("utf-8", "replace"))
                        break
        except (zipfile.BadZipFile, OSError):
            rec["corrupt"] = True
        out[f.stem] = rec
    return out


def git(repo, *args, timeout=5):
    """Run a git command in repo, returning stdout or None."""
    try:
        res = subprocess.run(
            ["git", "-C", str(repo), *args],
            capture_output=True, text=True, timeout=timeout,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return res.stdout if res.returncode == 0 else None


def my_emails(repos):
    """Emails that count as me: global git config, plus each repo's config.

    Seeded rather than hardcoded so a second address (a GitHub noreply, a
    personal account) starts counting the moment it's configured anywhere.
    """
    found = set()
    out = git(Path.home(), "config", "--global", "user.email")
    if out and out.strip():
        found.add(out.strip().lower())
    for repo in repos:
        out = git(repo, "config", "user.email")
        if out and out.strip():
            found.add(out.strip().lower())
    return found


def repo_root(path):
    out = git(path, "rev-parse", "--show-toplevel")
    return Path(out.strip()) if out and out.strip() else None


def classify_authorship(root, skill_path, mine):
    """Who wrote this skill: 'mine', 'others', 'uncommitted', or 'unknown'.

    Path membership is a poor proxy for authorship — most skills in these
    checkouts are teammates'. git log is the real signal and it self-maintains.
    """
    if root is None:
        return "unknown", []
    rel = os.path.relpath(skill_path, root)
    out = git(root, "log", "--format=%ae", "--max-count=50", "--", rel)
    if out is None:
        return "unknown", []
    authors = sorted({a.strip().lower() for a in out.split("\n") if a.strip()})
    if not authors:
        # No history: either never committed (probably mine, and unbacked) or
        # vendored in via a squashed import (not mine).
        tracked = git(root, "ls-files", "--error-unmatch", rel)
        return ("others", []) if tracked else ("uncommitted", [])
    return ("mine" if mine & set(authors) else "others"), authors


def load_config():
    """skill-sources.json, or an empty config if it isn't there."""
    raw = read_text(CONFIG)
    if raw is None:
        return {}
    try:
        return json.loads(raw)
    except json.JSONDecodeError as exc:
        # Exit 2, not the 1 that a bare SystemExit(str) would give — 1 means
        # "drift found", and a broken config must not masquerade as that.
        print(f"skill-status: {CONFIG} is not valid JSON: {exc}", file=sys.stderr)
        raise SystemExit(2)


def load_repos(cfg):
    """Repo-local skills, from the explicit list in skill-sources.json."""
    if not cfg:
        return [], ["no skill-sources.json — repo scan skipped"]

    paths, notes = [], []
    for entry in cfg.get("repos", []):
        path = Path(os.path.expanduser(entry))
        if path.is_dir():
            paths.append(path)
        else:
            notes.append(f"missing, skipped: {entry}")

    roots = {p: repo_root(p) for p in paths}
    mine = my_emails([r for r in roots.values() if r])
    for extra in cfg.get("authors", []):
        mine.add(extra.strip().lower())

    groups = []
    for path in paths:
        skills = scan_dir(path)
        if not skills:
            continue
        root = roots.get(path)
        for name, rec in skills.items():
            rec["authorship"], rec["authors"] = classify_authorship(
                root, rec["path"], mine
            )
        # Label by repo. Skills sit at either <repo>/.claude/skills or
        # <repo>/skills, so step over a .claude/.agents parent but not a
        # bare one — otherwise <repo>/skills gets labelled with $HOME.
        label = (path.parent.parent.name
                 if path.parent.name in (".claude", ".agents")
                 else path.parent.name)
        groups.append({"label": label, "path": str(path), "skills": skills})
    return groups, notes


# -------------------------------------------------------------------- drift

def find_drift(dotfiles, claude, cowork, bundles):
    issues = []

    for name, rec in sorted(dotfiles.items()):
        cw = cowork["skills"].get(name)
        if rec["cowork"] and cowork["available"] and not cw:
            issues.append({
                "skill": name, "kind": "not-uploaded",
                "detail": "marked for Cowork but not present there",
                "fix": f"skill-package {name}, then upload it in Cowork",
            })
        elif cw and cw["norm"] is not None and cw["norm"] != rec["norm"]:
            delta = (rec["lines"] or 0) - (cw["lines"] or 0)
            shape = (f"dotfiles is {delta} lines longer" if delta > 0
                     else f"Cowork copy is {-delta} lines longer" if delta < 0
                     else "same length, different content")
            # Edits flow both ways now: Cowork exports down into dotfiles, and
            # dotfiles edits are packaged and uploaded up. So name the stale
            # side from the timestamps instead of assuming a direction.
            cw_ts = parse_iso(cw.get("updated_at"))
            df_ts = rec.get("mtime") or 0
            if cw_ts is None:
                who = "unknown which is newer — Cowork reports no timestamp"
                fix = f"skill-status --diff {name} to see which side you want"
            elif cw_ts - df_ts > CLOCK_SKEW:
                who = "Cowork is newer"
                fix = "the Cowork export hasn't reached dotfiles yet — re-run it"
            elif df_ts - cw_ts > CLOCK_SKEW:
                who = "dotfiles is newer"
                fix = f"skill-package {name}, then re-upload it in Cowork"
            else:
                who = "edited at about the same time on both sides"
                fix = f"skill-status --diff {name} — reconcile by hand"
            issues.append({
                "skill": name, "kind": "cowork-stale",
                "detail": f"dotfiles ≠ Cowork ({shape}; {who})",
                "fix": fix,
                "diff": (cw["norm"], rec["norm"], "cowork", "dotfiles"),
            })

        if rec.get("git") == "uncommitted":
            issues.append({
                "skill": name, "kind": "uncommitted",
                "detail": "in dotfiles but not committed — not backed up yet",
                "fix": f"git -C ~/.dotfiles add ai/skills/{name} && git commit",
            })

        if rec["declared_name"] and rec["declared_name"] != name:
            issues.append({
                "skill": name, "kind": "name-mismatch",
                "detail": f"frontmatter name is '{rec['declared_name']}' — Cowork rejects this",
                "fix": f"set `name: {name}` in {rec['path']}/SKILL.md",
            })

        b = bundles.get(name)
        if rec["cowork"]:
            if b is None:
                issues.append({
                    "skill": name, "kind": "no-bundle",
                    "detail": "no staged .skill bundle",
                    "fix": f"skill-package {name}",
                })
            elif b.get("corrupt"):
                issues.append({
                    "skill": name, "kind": "bundle-corrupt",
                    "detail": "staged bundle is not a readable zip",
                    "fix": f"skill-package {name}",
                })
            elif b["norm"] is not None and b["norm"] != rec["norm"]:
                issues.append({
                    "skill": name, "kind": "bundle-stale",
                    "detail": "staged bundle is older than the source — the repackage hook may not be running",
                    "fix": f"skill-package {name}",
                })

    if cowork["available"]:
        for name, cw in sorted(cowork["skills"].items()):
            if name not in dotfiles:
                issues.append({
                    "skill": name, "kind": "cowork-only",
                    "detail": "lives only in Cowork — no dotfiles copy, not backed up",
                    "fix": "copy it into ~/.dotfiles/ai/skills/ if you want it version-controlled",
                })
            if not cw["enabled"]:
                issues.append({
                    "skill": name, "kind": "disabled",
                    "detail": "disabled in Cowork",
                    "fix": "re-enable it in Cowork, or delete it",
                })

    if CLAUDE_SKILLS.is_dir():
        for entry in sorted(CLAUDE_SKILLS.iterdir()):
            if entry.is_symlink() and not entry.exists():
                issues.append({
                    "skill": entry.name, "kind": "broken-symlink",
                    "detail": f"dangling symlink -> {os.readlink(entry)}",
                    "fix": f"rm {entry}, then re-run ~/.dotfiles/ai/install.sh",
                })

    return issues


def render_diff(a, b, a_label, b_label, limit=None):
    lines = list(difflib.unified_diff(
        a.split("\n"), b.split("\n"),
        fromfile=a_label, tofile=b_label, lineterm="", n=0,
    ))
    if limit is not None and len(lines) > limit:
        return lines[:limit] + [f"... {len(lines) - limit} more diff lines (--diff to see all)"]
    return lines


# ------------------------------------------------------------------- report

def main():
    ap = argparse.ArgumentParser(
        prog="skill-status",
        description="Inventory the Claude skills you author and report drift between copies.",
    )
    ap.add_argument("--drift-only", action="store_true", help="only show problems")
    ap.add_argument("--json", action="store_true", dest="as_json", help="machine-readable output")
    ap.add_argument("--diff", metavar="NAME", help="full diff of one skill against its Cowork copy")
    ap.add_argument("--no-repos", action="store_true", help="skip the repo scan")
    ap.add_argument("--all", action="store_true", dest="show_all",
                    help="include repo skills written by other people")
    args = ap.parse_args()

    s = Style(sys.stdout.isatty() and not os.environ.get("NO_COLOR"))

    cfg = load_config()
    not_mine = frozenset(cfg.get("not_mine", []))

    dotfiles = scan_dir(DOTFILES)
    for rec in dotfiles.values():
        rec["git"] = git_state(rec["path"])
    claude = scan_dir(CLAUDE_SKILLS)
    cowork = load_cowork(not_mine)
    bundles = load_bundles()
    scheduled = scan_dir(SCHEDULED)
    repos, repo_notes = ([], []) if args.no_repos else load_repos(cfg)

    # --diff short-circuits the report.
    if args.diff:
        name = args.diff
        src = dotfiles.get(name)
        cw = cowork["skills"].get(name)
        if not src:
            print(f"no dotfiles skill named '{name}'", file=sys.stderr)
            return 2
        if not cw or cw["norm"] is None:
            print(f"no Cowork copy of '{name}' to compare against", file=sys.stderr)
            return 2
        out = render_diff(cw["norm"], src["norm"], f"cowork/{name}", f"dotfiles/{name}")
        if not out:
            print(s.ok(f"{name}: identical"))
            return 0
        print("\n".join(out))
        return 1

    issues = find_drift(dotfiles, claude, cowork, bundles)

    if args.as_json:
        print(json.dumps({
            "dotfiles": [
                {k: v for k, v in r.items() if k not in ("text", "norm")}
                for r in dotfiles.values()
            ],
            "cowork": {
                "available": cowork["available"],
                "total": cowork["total"],
                "synced": cowork["synced"].isoformat() if cowork["synced"] else None,
                "excluded_not_mine": cowork.get("excluded", []),
                "mine": [
                    {k: v for k, v in r.items() if k not in ("text", "norm")}
                    for r in cowork["skills"].values()
                ],
            },
            "scheduled": sorted(scheduled),
            "repos": [{"label": g["label"], "path": g["path"],
                       "skills": [{"name": n, "authorship": r.get("authorship"),
                                   "authors": r.get("authors", [])}
                                  for n, r in sorted(g["skills"].items())]}
                      for g in repos],
            "bundles": sorted(bundles),
            "issues": [{k: v for k, v in i.items() if k != "diff"} for i in issues],
        }, indent=2))
        return 1 if issues else 0

    authored = len(set(dotfiles) | set(cowork["skills"]) | set(scheduled))
    for g in repos:
        authored += sum(1 for r in g["skills"].values()
                        if r.get("authorship") in ("mine", "uncommitted"))

    if not args.drift_only:
        head = s.bold("SKILLS YOU AUTHOR")
        tail = f"{authored} skills"
        tail += s.err(f" · {len(issues)} issues") if issues else s.ok(" · no drift")
        print(f"\n{pad(head, 52)}{tail}\n")

        if dotfiles:
            print(s.bold("dotfiles") + s.dim("  ~/.dotfiles/ai/skills"))
            for name, rec in sorted(dotfiles.items()):
                where = []
                if name in claude:
                    where.append("claude-code")
                if name in cowork["skills"]:
                    where.append("cowork")
                mark = "cowork:yes" if rec["cowork"] else s.dim("cowork:no")
                print(f"  {pad(name, 28)}{pad(mark, 13)}{s.dim('→ ' + ', '.join(where) if where else '→ nowhere else')}")
            print()

        if cowork["available"]:
            when = cowork["synced"].strftime("%Y-%m-%d %H:%M") if cowork["synced"] else "unknown"
            head = s.bold("cowork") + s.dim(f"  {cowork['total']} total · {len(cowork['skills'])} mine")
            print(f"{pad(head, 60)}{s.dim('synced ' + when)}")
            flagged = {i["skill"] for i in issues if i["kind"].startswith("cowork") or i["kind"] == "disabled"}
            for name, cw in sorted(cowork["skills"].items()):
                state = "enabled" if cw["enabled"] else s.warn("disabled")
                note = s.warn("⚠ see drift") if name in flagged else ""
                print(f"  {pad(name, 28)}{pad(state, 13)}{note}")
            for name in cowork.get("excluded", []):
                print(f"  {pad(name, 28)}{s.dim('not mine — excluded via skill-sources.json')}")
            print()
        else:
            print(s.dim("cowork  not readable on this machine\n"))

        if scheduled:
            print(s.bold("scheduled") + s.dim(f"  ~/Documents/Claude/Scheduled · {len(scheduled)}"))
            print(s.dim("  " + ", ".join(sorted(scheduled))))
            print()

        if repos:
            total = sum(len(g["skills"]) for g in repos)
            n_mine = sum(1 for g in repos for r in g["skills"].values()
                         if r.get("authorship") in ("mine", "uncommitted"))
            print(s.bold("repos") + s.dim(f"  {n_mine} yours of {total} found"))
            width = max(len(g["label"]) for g in repos) + 2
            for g in repos:
                keep = "mine", "uncommitted"
                rows = sorted(n for n, r in g["skills"].items()
                              if args.show_all or r.get("authorship") in keep)
                others = sum(1 for r in g["skills"].values()
                             if r.get("authorship") not in keep)
                tail = (s.dim(f"({others} by others)")
                        if others and not args.show_all else "")
                if rows:
                    shown = ", ".join(rows[:4])
                    if len(rows) > 4:
                        shown += f", +{len(rows) - 4} more"
                    print(f"  {pad(g['label'], width)}{s.dim(shown)}  {len(rows)}  {tail}")
                elif tail:
                    # No skills of mine here — still name the repo, or the
                    # count line reads as belonging to the repo above it.
                    print(f"  {pad(g['label'], width)}{tail}")
            print()
        for note in repo_notes:
            print(s.dim(f"  {note}"))
        if repo_notes:
            print()

    if issues:
        print(s.bold(s.err("DRIFT")))
        for i in issues:
            print(f"  {s.bold(i['skill'])}  {s.warn(i['detail'])}")
            if i.get("diff"):
                a, b, al, bl = i["diff"]
                for line in render_diff(a, b, al, bl, limit=DIFF_PREVIEW_LINES):
                    print(s.dim(f"    {line}"))
            print(s.dim(f"    → {i['fix']}"))
        print()
        return 1

    if args.drift_only:
        print(s.ok("no drift"))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
