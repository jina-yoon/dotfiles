# ~/.gitconfig -> ~/.dotfiles/git/gitconfig.symlink
#
# Identity lives in ~/.gitconfig.local, which is generated by script/bootstrap
# and never committed.

[include]
	path = ~/.gitconfig.local

[core]
	excludesfile = ~/.gitignore
	editor = vim

[init]
	defaultBranch = main

[push]
	default = current
	autoSetupRemote = true

[pull]
	rebase = true

[fetch]
	prune = true

[diff]
	colorMoved = zebra

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[gpg]
	format = ssh
[user]
	signingkey = /Users/jinayoon/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/PublicKeys/92b987f1412ef9bb7502956c39ebb621.pub
[commit]
	gpgsign = true
